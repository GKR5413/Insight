# Copy to .env and fill in the two required values. .env is git-ignored.

# --- Required ---------------------------------------------------------------
# SEC EDGAR requires a descriptive User-Agent that includes a contact email.
SEC_USER_AGENT=Your Name your-email@example.com

# Gemini API key (https://aistudio.google.com/apikey). GEMINI_API_KEY is accepted as an alias.
GOOGLE_API_KEY=

# --- Models -----------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-latest
# Tried in order when the primary is overloaded (503), over quota (429) or retired (404).
LLM_FALLBACK_MODELS=gemini-3.6-flash,gemini-flash-lite-latest
EMBEDDINGS_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
# Texts per minute the embedding API allows. Gemini's free tier is 100; use 0 (no pacing) on a paid tier.
EMBEDDING_RPM=80

# --- Storage ----------------------------------------------------------------
# Empty = Milvus Lite file at data/milvus.db. Set http://localhost:19530 for a standalone server.
MILVUS_URI=
# If Redis is not running the app falls back to an in-process cache.
REDIS_URL=redis://localhost:6379/0

# Bulk statement figures: used automatically when data/fsds.sqlite exists (see README). USE_FSDS=false forces R-page scraping.
USE_FSDS=true
FSDS_PATH=

# --- Quotes (~15 min delayed is fine) ---------------------------------------
# Tried in order; finnhub is skipped when FINNHUB_API_KEY is empty.
QUOTE_PROVIDERS=finnhub,cboe,yfinance
FINNHUB_API_KEY=

# --- Optional: tracing ------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=stock-briefing
